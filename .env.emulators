# Used by `npm run demo` / `npm run dev:emulators` (vite --mode emulators).
# Points the app at the LOCAL Firebase emulators, never the real project.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-bargout
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-bargout.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
